@using PiperPicker.Models;
@using Microsoft.Extensions.Options
@inject IOptions<RadioSelectorOptions> Options

<div id="radio-container" class="stackable">
        <div id="radio-list" class="content-list">
            @foreach (var radioStation in Model.RadioStreams)
            {
                <ListItem MopidyItem=radioStation></ListItem>
            }
        </div>
</div>

@code {
    private RadioSelectorOptions Model => Options.Value;
}
